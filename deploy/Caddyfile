{
	admin off
	auto_https off
}

:3000 {
	reverse_proxy app-a:3000 app-b:3000 {
		lb_policy round_robin
		lb_try_duration 3s

		health_uri /healthz
		health_interval 2s
		health_timeout 1s

		# WebSocket upgrades are proxied as-is; the client reconnects on its own
		# when a replica goes away mid-deploy.
		flush_interval -1
	}
}
