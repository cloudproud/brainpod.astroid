# Managed Postgres — durable truth: one row per finished run.
DATABASE_URL=postgres://asteroids:asteroids@localhost:5432/asteroids

# Managed Valkey (Redis protocol) — leader lease, world handoff, snapshot fan-out.
REDIS_URL=redis://localhost:6379

PORT=3000

# Identifies this replica. On Brainpod the pod's hostname is already unique,
# so leaving these unset is the normal case; they exist for local clusters.
# POD_ID=local-1
# RELEASE_ID=dev

# Shown in the corner badge.
REGION=eu-west-1

# Set to 0 when nothing trustworthy sets X-Forwarded-For in front of the app.
TRUST_PROXY=1

# Abuse limits. The defaults assume a room of people behind one office IP;
# tighten them for a URL left open on the internet unattended.
# MAX_SHIPS_PER_IP=12
# JOINS_PER_MINUTE=60
